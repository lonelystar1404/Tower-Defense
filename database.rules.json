{
  "rules": {
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[2-9A-HJKMNP-Z]{5}$/)",
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() ? newData.child('host').val() === auth.uid : data.child('host').val() === auth.uid)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta').exists()",
            ".validate": "!newData.exists() || newData.child('member').isString() && newData.child('member').val().length <= 32"
          }
        },
        "inbox": {
          "$id": {
            ".write": "auth != null && (!data.exists() && newData.child('u').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists() || !newData.exists() && root.child('rooms').child($code).child('meta/host').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.child('c/k').isString()"
          }
        },
        "turns": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
        },
        "checks": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
        }
      }
    }
  }
}
